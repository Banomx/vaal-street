From dd01fb0337402ceca7356254e3b04310e250d963 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 14:05:44 +0000
Subject: [PATCH 02/11] CI: don't cancel an in-flight Pages deployment

A second run entering the 'pages' concurrency group was cancelling the
first mid-deploy, which surfaces as 'Error: Deployment cancelled' from
actions/deploy-pages after a green build. Queue instead, per GitHub's
own Pages starter workflow.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ERdvL4QxcxEM9GTbJLR9Db
---
 .github/workflows/deploy.yml | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index e8fe148..a5ce980 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -17,9 +17,17 @@ permissions:
   pages: write
   id-token: write
 
+# One deployment at a time, but never kill one that is already running.
+# With cancel-in-progress: true, a second run entering this group (a quick
+# follow-up push, or the 4-hourly cron landing on top of a push) cancels the
+# first — and because the group covers the deploy job too, that surfaces as
+# "Error: Deployment cancelled" from actions/deploy-pages after the build has
+# already succeeded. false makes the newer run queue instead; GitHub still
+# drops any run that gets superseded while it is only pending, so the latest
+# commit is what ends up live either way.
 concurrency:
   group: pages
-  cancel-in-progress: true
+  cancel-in-progress: false
 
 jobs:
   build:
-- 
2.43.0


From e09dd89bf4b87e660e79e87356fb4224a661b37d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 6 Aug 2026 14:40:32 +0000
Subject: [PATCH 03/11] CI: give the Pages deployment 30 minutes before
 aborting

actions/deploy-pages defaults to a 10-minute wait and CANCELS the
deployment when it expires. GitHub's Pages backend intermittently sits
in deployment_queued/syncing_files past that (actions/deploy-pages#406),
so the timeout was converting slow-but-fine deployments into failures.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ERdvL4QxcxEM9GTbJLR9Db
---
 .github/workflows/deploy.yml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/.github/workflows/deploy.yml b/.github/workflows/deploy.yml
index a5ce980..95493e1 100644
--- a/.github/workflows/deploy.yml
+++ b/.github/workflows/deploy.yml
@@ -61,3 +61,11 @@ jobs:
     steps:
       - id: deployment
         uses: actions/deploy-pages@v4
+        with:
+          # The action's default is 10 minutes, and when it gives up it does not
+          # just fail — it CANCELS the deployment it was waiting on. GitHub's
+          # Pages backend intermittently sits in deployment_queued / syncing_files
+          # for longer than that (actions/deploy-pages#406, open and upstream),
+          # which turns a deployment that would have landed into a failed run.
+          # Waiting half an hour costs nothing; the job is idle polling.
+          timeout: 1800000
-- 
2.43.0


From 10661076a0ac56471eb7ad984f302d9e0fa5cce0 Mon Sep 17 00:00:00 2001
